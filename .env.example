# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Application ---
APP_NAME=DocuMind AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- Storage / PDF ---
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=1000
MIN_EXTRACTABLE_CHARS=20
# OCR for scanned PDFs - requires Tesseract installed and on PATH
# (the Docker image includes it and docker-compose turns OCR on)
OCR_ENABLED=false
OCR_LANGUAGE=eng

# --- Database (defaults match docker-compose.yml for local dev) ---
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_dev_password
POSTGRES_DB=documind
DATABASE_URL=postgresql+psycopg://documind:documind_dev_password@localhost:5432/documind
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# TEST_DATABASE_URL=postgresql+psycopg://documind:documind_dev_password@localhost:5432/documind_test

# --- Chunking (tokens; overlap must be smaller than size) ---
CHUNK_SIZE_TOKENS=120
CHUNK_OVERLAP_TOKENS=20

# --- Embeddings (dimension must match the model AND the DB migration) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# --- Authentication (REQUIRED) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Rotating refresh token (httpOnly cookie). Secure flag defaults to on in production.
REFRESH_TOKEN_EXPIRE_DAYS=14
# REFRESH_COOKIE_SECURE=true

# --- Email (verification + password reset) ---
# console = print emails to the log (local dev); smtp = send via SMTP_HOST.
# docker-compose defaults to smtp via Mailpit (inbox at http://localhost:8025).
EMAIL_BACKEND=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
EMAIL_FROM=DocuMind AI <no-reply@documind.local>
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30
# true = unverified accounts cannot log in
REQUIRE_EMAIL_VERIFICATION=false

# --- Redis / Celery background processing ---
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=          # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=      # defaults to redis db 1
PROCESSING_SOFT_TIME_LIMIT=900
PROCESSING_TIME_LIMIT=1200
PROCESSING_MAX_RETRIES=3
PROCESSING_RETRY_BACKOFF=10
PROCESSING_STALE_AFTER=1800

# --- LLM answer generation ---
# auto = use OpenAI if OPENAI_API_KEY is set, otherwise local extractive answers
LLM_PROVIDER=auto
OPENAI_API_KEY=
# Any OpenAI-compatible server, e.g. Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=30

# --- RAG retrieval ---
RAG_TOP_K=5
RAG_MIN_SCORE=0.20
RAG_MAX_CONTEXT_TOKENS=1800
RAG_HNSW_EF_SEARCH=100
# vector | hybrid (semantic + full-text search, Reciprocal Rank Fusion)
RAG_RETRIEVAL_MODE=hybrid
RAG_CANDIDATE_POOL=10
# Cross-encoder re-ranking; when on, RAG_RERANK_MIN_SCORE (not RAG_MIN_SCORE) is the relevance gate.
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_MIN_SCORE=-6.0

# --- Rate limiting (Redis, fixed window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_IP=10        # per minute
RATE_LIMIT_LOGIN_PER_EMAIL=10     # per 15 minutes
RATE_LIMIT_REGISTER_PER_IP=5      # per hour
RATE_LIMIT_CHAT_PER_USER=30       # per minute
RATE_LIMIT_UPLOAD_PER_USER=30     # per hour

# --- Caching (Redis) ---
CACHE_ENABLED=true
CACHE_QUERY_EMBEDDING_TTL=86400
CACHE_ANSWER_TTL=600

# --- Observability / startup ---
SLOW_REQUEST_MS=1500
# Prometheus endpoint GET /metrics (internal; nginx does not route it)
METRICS_ENABLED=true
# METRICS_TOKEN=          # optional: require "Authorization: Bearer <token>"
# Grafana login (docker compose --profile monitoring)
# GRAFANA_ADMIN_PASSWORD=
PRELOAD_EMBEDDING_MODEL=true

# --- Security ---
# HSTS_ENABLED=true only when the site is served over HTTPS
HSTS_ENABLED=false
# Swagger UI /docs: defaults to on in development, off in production
# API_DOCS_ENABLED=
